# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored -- never commit real secrets.

ENVIRONMENT=development

# Owner/migration connection (your local superuser role).
DATABASE_URL=postgresql+psycopg://<your-local-user>@localhost/builder

# Least-privilege role the application runs as at runtime.
APP_DATABASE_URL=postgresql+psycopg://builder_app@localhost/builder

BASE_URL=http://localhost:8000

# Dev-only shared secret. Generate with: openssl rand -base64 24 | tr '+/' '-_'
DEV_AUTH_SECRET=

# Ed25519 signing keys (PEM, PKCS#8). Generate with:
#   openssl genpkey -algorithm ed25519
# JWT_PRIVATE_KEY signs new tokens; JWT_PRIVATE_KEY_NEXT is the standby key
# for rotation (published in the JWKS so it verifies before it starts signing).
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"
JWT_PRIVATE_KEY_NEXT="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"
