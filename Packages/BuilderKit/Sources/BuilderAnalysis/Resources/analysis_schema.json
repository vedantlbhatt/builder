{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED by scripts/gen_analysis.py from spec/analysis.v1.json — DO NOT EDIT. Handed to `claude -p --json-schema`.",
  "title": "SessionAnalysis",
  "description": "A reading of one coding session: what got built, how the person built it, and how they steered the agent. Every string is bounded, every score has a one-line rationale, and confidence is required. A field that cannot be grounded in the digest is null or empty, never guessed. Do not restate deterministic stats (lines, prompts, tool counts, tokens); they are measured elsewhere.",
  "type": "object",
  "properties": {
    "analysis_version": {
      "description": "== spec version. A retuned prompt is a recompute, not a migration.",
      "type": "integer",
      "const": 1
    },
    "model": {
      "description": "model id that wrote this, as reported by claude -p",
      "type": "string"
    },
    "generated_at": {
      "description": "(ISO 8601)",
      "type": "string",
      "format": "date-time"
    },
    "digest_hash": {
      "description": "hash of the digest that was analysed; lets sync skip an unchanged analysis (64 lowercase hex chars)",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest_coverage": {
      "description": "fraction of the session's events that fit in the digest (1.0 = nothing sampled out) (0-1)",
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "headline": {
      "description": "one line: what this session was. Past tense, no trailing period. (max 90 chars)",
      "type": "string",
      "maxLength": 90
    },
    "summary": {
      "description": "2-4 sentences: what got done, what did not, how it ended (max 700 chars)",
      "type": "string",
      "maxLength": 700
    },
    "outcome": {
      "type": "string",
      "enum": [
        "shipped",
        "progressed",
        "explored",
        "blocked",
        "abandoned",
        "maintenance"
      ]
    },
    "features": {
      "description": "the high-level things that were built or changed (max 8 items)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Feature"
      },
      "maxItems": 8
    },
    "work_mix": {
      "description": "shares summing to ~1.0 across work kinds present (keys are work_kind values, each value 0-1)",
      "type": "object",
      "properties": {
        "feature": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "bugfix": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "refactor": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "infra": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "docs": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "test": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "research": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "ops": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": false
    },
    "build_style": {
      "$ref": "#/$defs/BuildStyle"
    },
    "dimensions": {
      "description": "exactly one entry per dimension (max 5 items)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/DimensionScore"
      },
      "maxItems": 5
    },
    "archetype": {
      "description": "null when the session is too short to say",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "architect",
            "velocity_machine",
            "quality_guardian",
            "night_owl",
            "explorer",
            "firefighter"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_patterns": {
      "description": "signature moves in how the person directed the agent, each grounded in a prompt (max 5 items)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/DecisionPattern"
      },
      "maxItems": 5
    },
    "pivots": {
      "description": "(max 5 items)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Pivot"
      },
      "maxItems": 5
    },
    "friction": {
      "description": "(max 6 items)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Friction"
      },
      "maxItems": 6
    },
    "prompting": {
      "$ref": "#/$defs/Prompting"
    },
    "growth_edge": {
      "description": "specific things to try next, grounded in THIS session (each max 300 chars, max 3 items)",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      },
      "maxItems": 3
    },
    "tags": {
      "description": "lowercase, kebab-case (each max 140 chars, max 8 items)",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 140
      },
      "maxItems": 8
    },
    "confidence": {
      "description": "0-1: how well the digest supported these conclusions",
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "contains_sensitive": {
      "description": "the model noticed secrets/PII in the digest; the UI warns before sharing",
      "type": "boolean"
    }
  },
  "required": [
    "analysis_version",
    "model",
    "generated_at",
    "digest_hash",
    "digest_coverage",
    "headline",
    "summary",
    "outcome",
    "features",
    "work_mix",
    "build_style",
    "dimensions",
    "decision_patterns",
    "pivots",
    "friction",
    "prompting",
    "growth_edge",
    "tags",
    "confidence",
    "contains_sensitive"
  ],
  "additionalProperties": false,
  "$defs": {
    "Feature": {
      "type": "object",
      "properties": {
        "name": {
          "description": "(max 140 chars)",
          "type": "string",
          "maxLength": 140
        },
        "status": {
          "type": "string",
          "enum": [
            "done",
            "partial",
            "started",
            "reverted"
          ]
        },
        "detail": {
          "description": "(max 300 chars)",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "description": "digest event ordinals that support this (max 6 items)",
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 6
        }
      },
      "required": [
        "name",
        "status",
        "evidence"
      ],
      "additionalProperties": false
    },
    "BuildStyle": {
      "type": "object",
      "properties": {
        "planning": {
          "type": "string",
          "enum": [
            "none",
            "light",
            "explicit_plan",
            "plan_mode"
          ]
        },
        "iteration": {
          "type": "string",
          "enum": [
            "linear",
            "iterative",
            "pivoted",
            "thrashing"
          ]
        },
        "steering": {
          "type": "string",
          "enum": [
            "hands_off",
            "guided",
            "tight_loop",
            "micromanaged"
          ]
        },
        "verification": {
          "type": "string",
          "enum": [
            "none",
            "manual_check",
            "ran_tests",
            "tests_added"
          ]
        },
        "scope_control": {
          "type": "string",
          "enum": [
            "held",
            "expanded",
            "narrowed"
          ]
        },
        "architecture_note": {
          "description": "how they structured the work, if visible (max 300 chars)",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "planning",
        "iteration",
        "steering",
        "verification",
        "scope_control"
      ],
      "additionalProperties": false
    },
    "DimensionScore": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string",
          "enum": [
            "steering",
            "execution",
            "engineering",
            "product_instinct",
            "planning"
          ]
        },
        "score": {
          "description": "0-100",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "rationale": {
          "description": "(max 140 chars)",
          "type": "string",
          "maxLength": 140
        }
      },
      "required": [
        "dimension",
        "score",
        "rationale"
      ],
      "additionalProperties": false
    },
    "DecisionPattern": {
      "type": "object",
      "properties": {
        "pattern": {
          "description": "(max 140 chars)",
          "type": "string",
          "maxLength": 140
        },
        "prompt_excerpt": {
          "description": "verbatim from a prompt, trimmed (max 160 chars)",
          "type": "string",
          "maxLength": 160
        },
        "effect": {
          "description": "(max 140 chars)",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 140
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pattern",
        "prompt_excerpt"
      ],
      "additionalProperties": false
    },
    "Pivot": {
      "type": "object",
      "properties": {
        "at_minute": {
          "type": "integer"
        },
        "from_goal": {
          "description": "(max 140 chars)",
          "type": "string",
          "maxLength": 140
        },
        "to_goal": {
          "description": "(max 140 chars)",
          "type": "string",
          "maxLength": 140
        },
        "trigger": {
          "description": "(max 140 chars)",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 140
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "at_minute",
        "from_goal",
        "to_goal"
      ],
      "additionalProperties": false
    },
    "Friction": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "misunderstanding",
            "tool_failure",
            "env_issue",
            "model_error",
            "scope_creep",
            "human_error",
            "waiting"
          ]
        },
        "description": {
          "description": "(max 140 chars)",
          "type": "string",
          "maxLength": 140
        },
        "cost_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "additionalProperties": false
    },
    "Prompting": {
      "type": "object",
      "properties": {
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "terse",
            "polite",
            "frustrated",
            "mixed"
          ]
        },
        "specificity": {
          "description": "0-100: how precisely prompts specified what was wanted",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "correction_share": {
          "description": "fraction of prompts that corrected or redirected the agent (0-1)",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "question_share": {
          "description": "fraction of prompts that asked rather than directed (0-1)",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "note": {
          "description": "(max 300 chars)",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tone",
        "specificity",
        "correction_share",
        "question_share"
      ],
      "additionalProperties": false
    }
  }
}
